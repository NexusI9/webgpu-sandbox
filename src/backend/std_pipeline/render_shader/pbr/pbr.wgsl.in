// fragment shader
@fragment
fn fs_main(@location(0) vNormal: vec3<f32>,
    @location(1) vTangent: vec3<f32>,
    @location(2) vBitangent: vec3<f32>,
    @location(3) vCol: vec3<f32>,
    @location(4) vUv: vec2<f32>,
    @location(5) vFrag: vec3<f32>) -> @location(0) vec4<f32> {

    let camera = uCamera;

  // TBN is actually NBT, for unkown reason (for Vulkan as well...)
  // https://gamedev.stackexchange.com/questions/128867/simplst-possible-tbn-matrix-giving-weird-results
  // Update: It s related to the texture format encoding:
  // When encoding texture to:
  //     1. BGRA8Uint -> NBT
      //     2. RGBA8Uint -> TBN

      // DEBUG BEGIN

    let TBN = mat3x3<f32>(vTangent, vBitangent, vNormal);

    var albedo = textureSample(diffuse_texture, linear_sampler, vUv);
    var metallic = textureSample(metallic_texture, linear_sampler, vUv);
    var normal = textureSample(normal_texture, linear_sampler, vUv);
    var occlusion = textureSample(occlusion_texture, linear_sampler, vUv);
    var emissive = textureSample(emissive_texture, linear_sampler, vUv);

    let material = create_material(albedo, metallic, normal, occlusion, emissive, uPBR);

    if material.alpha < uPBR.alpha_threshold {
      discard;
    }

    let world_normal = normalize(TBN * material.normal);

    let coord = vec2<i32>(vUv);

    var light_pos = vec3<f32>(0.0f);
    var light_color = vec3<f32>(0.0f);
    var Lo: vec3<f32> = vec3<f32>(0.0f);
    var ambient: vec3<f32> = vec3<f32>(0.0f);

  // calculate point lights
    for (var i = 0u; i < uLights.point_count; i++) {
        let light = uLights.point_entries[i];
        Lo += compute_point_light(material, vFrag, world_normal, camera.position.xyz,
            light.position, light.color, light.intensity);
    }

  // calculate spot lights
  // basically the same a point light, but use a fixed light direction instead
  // of a one per fragment like a point light
    for (var i = 0u; i < uLights.spot_count; i = i + 1u) {
        let light = uLights.spot_entries[i];
    // let light_direction = light.position - light.lookat;
        Lo += compute_point_light(material, vFrag, world_normal, camera.position.xyz,
            light.position, light.color, light.intensity);
    }

  // calculate sun lights
    for (var i = 0u; i < uLights.sun_count; i = i + 1u) {
        let light = uLights.sun_entries[i];
        Lo += compute_point_light(material, vFrag, world_normal, camera.position.xyz,
            light.position, light.color, light.intensity);
    }

  // calulate ambient lights
    var ambient_intensity = 0.0f;
    for (var i = 0u; i < uLights.ambient_count; i = i + 1u) {
        let light = uLights.ambient_entries[i];
        ambient += compute_ambient_light(material, light.intensity, light.color);
        ambient_intensity += light.intensity;
    }

  //
  //
  // === reflection IBL ===
  //
  //

    var V: vec3<f32> = normalize(camera.position.xyz - vFrag); // view vector
    var R: vec3<f32> = normalize(reflect(-V, world_normal));

  // Fresnel
    let NdotV: f32 = dot_max(world_normal, V);
    let f0: vec3<f32> = mix(vec3<f32>(0.04f), material.albedo.rgb, material.metallic);
    let F: vec3<f32> = f0 + (1.0f - f0) * pow(1.0 - NdotV, 5.0f);
    let kD = (1.0f - F) * (1.0f - material.metallic);
    let diffuseIBL = textureSample(skybox_texture, linear_sampler, world_normal) * material.albedo;

    let mipCount = f32(textureNumLevels(skybox_texture));
    let lod = material.roughness * (mipCount - 1.0);
    let specularIBL = textureSampleLevel(skybox_texture, linear_sampler, R, lod).rgb;

  // plane reflection
    var plane_reflection: vec4<f32> = vec4<f32>(0.0f);
  
    //for (var i = 0u; i < uMesh.probe_reflection_plane_count; i++) {
//
//        let align = clamp(dot(world_normal, uProbes.reflection_plane[i].normal), 0.0f, 1.0f);
//
//        let local = vFrag - uProbes.reflection_plane[i].position;
//
//        let reflUV = compute_reflection_uv(vFrag, uProbes.reflection_plane[i].view);
//
//        plane_reflection = textureSampleLevel(
//            probe_reflection_plane_texture, linear_sampler, reflUV,
//            uProbes.reflection_plane[i].texture_layer, 0.0f
//        );
//
//        plane_reflection.a *= align;
//        plane_reflection.a /= 1.3f;
//    }
      //
 
      // fusion of skybox + reflection as overlay
    let specular_composite = mix(specularIBL, plane_reflection.rgb, plane_reflection.a);

    let IBL = kD * diffuseIBL.rgb + F * specular_composite;
    ambient += IBL;
      
  // shadow map computation
    let point_shadow = point_shadow_factor(vFrag, camera.position.xyz);
    let spot_shadow = spot_shadow_factor(vFrag, camera.position.xyz);
    let sun_shadow = sun_shadow_factor(vFrag, camera.position.xyz);

    let combined_shadow = mix(vec3<f32>(min(ambient_intensity, 1.0f)), vec3<f32>(1.0),
        point_shadow + spot_shadow + sun_shadow);

    let combined = vec4<f32>((ambient + Lo * combined_shadow) + material.emissive,
        1.0f);

    let fog_k = fog_factor(length(vFrag - camera.position.xyz),
        uEnvironment.fog.start_distance, uEnvironment.fog.density);

    let out_color = mix(combined, uEnvironment.fog.color, fog_k);

    //return vec4<f32>(albedo.a, 0.0f, 0.0f, 1.0f);
    return out_color;
    //return vec4<f32>(abs(vTangent), 1.0f);
}
