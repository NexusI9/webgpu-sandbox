//
//
// ▗▖  ▗▖▗▄▄▄▖▗▄▄▖▗▄▄▄▖▗▄▄▄▖▗▖  ▗▖
// ▐▌  ▐▌▐▌   ▐▌ ▐▌ █  ▐▌    ▝▚▞▘
// ▐▌  ▐▌▐▛▀▀▘▐▛▀▚▖ █  ▐▛▀▀▘  ▐▌
//  ▝▚▞▘ ▐▙▄▄▖▐▌ ▐▌ █  ▐▙▄▄▖▗▞▘▝▚▖
//
//
//
//

// vertex shader
  @vertex
fn vs_main(input: VertexIn) -> VertexOut {

    let mesh = uMesh;
    let camera = uCamera;
    let viewport = uViewport;

  // DEBUG
  // let proj : mat4x4<f32> = mat4x4<f32>(vec4<f32>(1.961671, 0.0, 0.0, 0.0),
  //                                     vec4<f32>(0.0, 3.487414, 0.0, 0.0),
  //                                     vec4<f32>(0.0, 0.0, -1.001001, -1.0),
  //                                     vec4<f32>(0.0, 0.0, -0.100100, 0.0));

  // DEBUG
  // let view : mat4x4<f32> =
  //               mat4x4<f32>(vec4<f32>(0.707107, -0.408248, 0.577350, 0.0),
  //                           vec4<f32>(0.0, 0.816496, 0.577350, 0.0),
  //                           vec4<f32>(-0.707107, -0.408248, 0.577350, 0.0),
  //                           vec4<f32>(-0.0, -0.0, -34.641010, 1.0));

  // Final Matrix (Projection * View)
    var cam: mat4x4<f32> = viewport.projection * camera.view;

    let normal = normalize((mesh.model * vec4<f32>(input.aNorm.xyz, 0.0f)).xyz);
  //let tangent = normalize((mesh.model * vec4<f32>(input.aTan.xyz, 0.0f)).xyz);
    let tangent = input.aTan.xyz;
    let bitangent = cross(normal, tangent) * input.aTan.w;

    var output: VertexOut;
    output.vPosition = cam * mesh.model * vec4<f32>(input.aPos, 1.0f);
    output.vNormal = normal;
    output.vTangent = tangent;
    output.vBitangent = bitangent;
    output.vCol = input.aCol;
    output.vUv = input.aUv;

  // transform vertex position (object local position) to world space
  // used for lightning to know where the vertex is in the world space
  // if only used model, vertex position is "constriained" its own local space
    output.vFrag = (mesh.model * vec4<f32>(input.aPos, 1.0f)).xyz;

    return output;
}

//
//
//
//
// ▗▄▄▖ ▗▄▄▖ ▗▄▄▖
// ▐▌ ▐▌▐▌ ▐▌▐▌ ▐▌
// ▐▛▀▘ ▐▛▀▚▖▐▛▀▚▖
// ▐▌   ▐▙▄▞▘▐▌ ▐▌
//
//
//
//
//

// Fresnel usin Schlick Approximation
fn f_schlick(F0: vec3<f32>, HdotV: f32) -> vec3<f32> {
  // Metallic surface : F0 = albedo
  // Dielectric surface : F0 = vec3(0.4) (plastic/ wood...)
    return F0 + (1.0f - F0) * pow(1.0f - HdotV, 5.0);
}

fn distribution_GGX(NdotH: f32, roughness: f32) -> f32 {
    var a = roughness * roughness;
    var a2 = a * a;
    var NdotH2 = NdotH * NdotH;

    var num = a2;
    var denom = (NdotH2 * (a2 - 1.0f) + 1.0f);
    denom = PI * denom * denom;
    return num / denom;
}

fn geo_schlick_ggx(NdotV: f32, roughness: f32) -> f32 {
    var r = (roughness + 1.0f);
    var k = (r * r) / 8.0f;
    return NdotV / (NdotV * (1.0f - k) + k);
}

fn geo_smith(NdotV: f32, NdotL: f32, roughness: f32) -> f32 {
    return geo_schlick_ggx(NdotV, roughness) * geo_schlick_ggx(NdotL, roughness);
}

fn dot_max(A: vec3<f32>, B: vec3<f32>) -> f32 { return max(dot(A, B), 0.0f); }

fn create_material(diffuse: vec4<f32>, metallic: vec4<f32>,
    normal: vec4<f32>, occlusion: vec4<f32>,
    emissive: vec4<f32>, factors: PBRMaterial) -> Material {

    var material: Material;
    material.albedo = diffuse * factors.base_color_factor;
    material.metallic = metallic.r * factors.metallic_factor;
    material.roughness = metallic.g * factors.roughness_factor; // roughness in G channel
    material.normal = normalize(normal.rgb * 2.0 - 1.0) * factors.normal_scale; // convert to [-1,+1]
    material.occlusion = occlusion.r * factors.occlusion_strength;
    material.emissive = emissive.rgb * factors.emissive_factor;
    material.alpha = factors.base_color_factor.a * diffuse.a;
    return material;
}

fn compute_point_light(material: Material, fragment_position: vec3<f32>,
    world_normal: vec3<f32>, camera_position: vec3<f32>,
    light_position: vec3<f32>, light_color: vec4<f32>,
    light_intensity: f32) -> vec3<f32> {

    let mesh = uMesh;

  // compute light base on Cook-Torrance BRDF Model

  // 1. Normalize key vectors
    var V: vec3<f32> = normalize(camera_position - fragment_position); // view vector
    let L_distance = light_position - fragment_position;
    var L: vec3<f32> = normalize(L_distance);
    var H: vec3<f32> = normalize(V + L); // halfway vector

  // 2. Fresnel effect
  // Determines how much light reflects vs. refracts
    var HdotV: f32 = dot_max(H, V);
    var F0: vec3<f32> = mix(vec3(0.04), material.albedo.rgb, material.metallic);
    var F: vec3<f32> = f_schlick(F0, HdotV);

  // 3. Normal Distribution Function - NDF (GGX/ Trowbridge-Reitz)
  // Determine how surface distribute microfacet (i.e. bumps)
    var NdotH: f32 = dot_max(world_normal, H);
    var D: f32 = distribution_GGX(NdotH, material.roughness);

  // 4.Geometry Function (Schlick-GGX)
  //  Handles shadow and masking
    var NdotV: f32 = dot_max(world_normal, V);
    var NdotL: f32 = dot_max(world_normal, L);
    var G = geo_smith(NdotV, NdotL, material.roughness);

  // 5. Define Cook-Torrance Specular Reflection
    var specular: vec3<f32> = (D * F * G) / (4.0f * NdotV * NdotL + 0.001);

  // 6. Compute Diffuse & Final lighting
  // Metallic surface only use the specular term
  // Non-Metallic surface use both diffuse + specular
    var kD = (vec3(1.0f) - F) * (1.0f - material.metallic);

    var diffuse: vec3<f32> = (material.albedo.rgb / PI);
    var Lo: vec3<f32> = (kD * diffuse + specular) * light_color.rgb * light_intensity * NdotL;

  // 8. Apply AO //0.03f
  // change first operator to alter ambient light
  // L / L_distance * L_distance;
    return Lo;
}

fn compute_ambient_light(material: Material, light_intensity: f32,
    light_color: vec4<f32>) -> vec3<f32> {
    return (light_color * light_intensity * material.albedo).rgb;
  // *  material.occlusion;
}

fn compute_point_depth(position: f32, near: f32, far: f32) -> f32 {

  // let norm_z_comp = (far + near) / (far - near) -
  //                   (2.0f * far * near) / (far - near) / local_z_comp;
  // let depth = norm_z_comp - 0.002f;

    let norm_z_comp = (-position * -1.0f * (far + near)) / (far - near) + ((-2.0f * far * near) / (far - near));

    let depth = (far + near) / (far - near) - 2.0f * far * near / (norm_z_comp * (far - near));

    return (depth + 1.0f) * 0.5f;
}

fn compute_reflection_uv(frag_pos: vec3<f32>, r_view: mat4x4<f32>) -> vec2<f32> {
    let clip = uViewport.projection * r_view * vec4<f32>(frag_pos, 1.0);
    let ndc = clip.xyz / clip.w;                                // [-1, 1] space
    let uv = ndc.xy * vec2<f32>(0.5f, -0.5f) + vec2<f32>(0.5f); // [0, 1] space
    return uv;
}

// https://x.com/JKoukourakis/status/1958800134914949268/photo/1
fn fog_factor(distance: f32, fog_start_distance: f32, fog_density: f32) -> f32 {

    let fog_distance: f32 = max(distance - fog_start_distance, 0.0f);
    let density: f32 = fog_density * 0.001;
    let exp_factor: f32 = 1.0f - exp(-density * fog_distance);
    return clamp(exp_factor, 0.0f, 1.0f);
}

//
//
//
//
//  ▗▄▄▖▗▖ ▗▖ ▗▄▖ ▗▄▄▄  ▗▄▖ ▗▖ ▗▖    ▗▖  ▗▖ ▗▄▖ ▗▄▄▖
// ▐▌   ▐▌ ▐▌▐▌ ▐▌▐▌  █▐▌ ▐▌▐▌ ▐▌    ▐▛▚▞▜▌▐▌ ▐▌▐▌ ▐▌
//  ▝▀▚▖▐▛▀▜▌▐▛▀▜▌▐▌  █▐▌ ▐▌▐▌ ▐▌    ▐▌  ▐▌▐▛▀▜▌▐▛▀▘
// ▗▄▄▞▘▐▌ ▐▌▐▌ ▐▌▐▙▄▄▀▝▚▄▞▘▐▙█▟▌    ▐▌  ▐▌▐▌ ▐▌▐▌
//
//
//
//
//
//
//

const PCF_KERNEL_MAX : u32 = 2u;
const PCF_MAX_DISTANCE : f32 = 5.0f;

fn kernel_from_distance(frag_pos: vec3<f32>, cam_pos: vec3<f32>) -> u32 {

    let d = distance(frag_pos, cam_pos);
    return select(3u, 0u, d > 2.0f);

  // let distance : f32 = distance(frag_pos, cam_pos);
  // let t : f32 = clamp(distance / PCF_MAX_DISTANCE, 0.0f, 1.0f);
  // return u32(mix(f32(PCF_KERNEL_MAX), 0.0f, t));
}

// Combine and compute Point light shadow
fn point_shadow_factor(frag_position: vec3<f32>, cam_pos: vec3<f32>) -> f32 {

    var factor: f32 = max(f32(uLights.point_count), 1.0f) * 1.0f; // show by default
    var bias: f32 = 0.002f;

    for (var l: u32 = 0u; l < uLights.point_count; l++) {

        let light = uLights.point_entries[l];
        let light_position = light.position;

        var frag_to_light = frag_position - light_position.xyz;

        let current_depth = length(frag_to_light);

        let far = 100.0f;
        let near = 0.1f;

#ifdef RENDER_SHADOW_AS_COLOR

        var closest_depth = textureSample(point_shadow_maps, point_shadow_sampler,
            normalize(frag_to_light), l)
                            .r;

        closest_depth = closest_depth * far;

        factor = select(1.0f, 0.0f, current_depth - bias > closest_depth);

#else

        let abs_vec = abs(frag_to_light);
        let local_z_comp = max(abs_vec.x, max(abs_vec.y, abs_vec.z));
        var shadow_direction = normalize(frag_to_light);

        let depth = compute_point_depth(local_z_comp, light.near, light.far);

        let dist = length(frag_to_light) / light.far;

        factor = smoothstep(light.cutoff, light.inner_cutoff, dist);
        factor = pow(factor, light.intensity);
        factor = select(factor, 0.0f, dist > light.cutoff);

    // PCF
        var pcf_shadow_factor = 0.0f;
        var pcf_sample_count = 0u;
        let pcf_kernel_size = PCF_KERNEL_MAX;
        let pcf_half_kernel_size: f32 = f32(pcf_kernel_size / 2u);
        let spread = 0.08f;

        for (var x = -pcf_half_kernel_size; x <= pcf_half_kernel_size; x += 1.0f) {
            for (var y = -pcf_half_kernel_size; y <= pcf_half_kernel_size; y += 1.0f) {
                for (var z = -pcf_half_kernel_size; z <= pcf_half_kernel_size; z += 1.0f) {

                    let offset = vec3(x, y, z) / light.far * spread;
                    let sample_direction = shadow_direction + offset;
                    pcf_shadow_factor += textureSampleCompare(point_shadow_maps, shadow_sampler,
                        sample_direction, l, depth - bias);
                    pcf_sample_count += 1u;
                }
            }
        }

        pcf_shadow_factor /= f32(pcf_sample_count);
        factor *= pcf_shadow_factor;

#endif
    }

    return factor;
}

//  Compute Directional light shadow

fn directional_shadow_position(world_position: vec3<f32>,
    light_view: mat4x4<f32>) -> vec3<f32> {

  // transform world position into clip space
    let shadow_clip = light_view * vec4<f32>(world_position, 1.0f);

  // convert to NDC coordinates
    var shadow_ndc = shadow_clip.xyz / shadow_clip.w;

  // convert to UV (0-1 range)
    let shadow_uv = shadow_ndc.xy * vec2<f32>(0.5f, -0.5f) + 0.5f;
    let shadow_depth = shadow_ndc.z;

  // returns depth to compare
    return vec3<f32>(shadow_uv, shadow_depth);
}

fn spot_shadow_factor(frag_position: vec3<f32>, cam_pos: vec3<f32>) -> f32 {

    var factor: f32 = max(f32(uLights.spot_count), 1.0f) * 1.0f; // show by default
    var bias: f32 = 0.001f;

    for (var l: u32 = 0u; l < uLights.spot_count; l++) {

        let light = uLights.spot_entries[l];
        let shadow_position = directional_shadow_position(frag_position, light.view);

#ifdef RENDER_SHADOW_AS_COLOR
        factor *= textureSample(directional_shadow_maps, directional_shadow_sampler,
            shadow_position.xy, l)
                  .r;

#else

        let frag_to_light = light.position - frag_position;
        let light_direction = normalize(frag_to_light);
        let spot_dot = dot(-light_direction, normalize(light.lookat - light.position));

        let shadow_depth = shadow_position.z - bias;

        factor = smoothstep(light.cutoff, light.inner_cutoff, spot_dot);
        factor = pow(factor, light.intensity);
        factor = select(factor, 0.0f, spot_dot < light.cutoff);

    // PCF
        var pcf_shadow_factor = 0.0f;
        var pcf_sample_count = 0u;
        let pcf_kernel_size = PCF_KERNEL_MAX;
        let pcf_half_kernel_size: f32 = f32(pcf_kernel_size / 2u);
        let spread = 1.0f;

        for (var x = -pcf_half_kernel_size; x <= pcf_half_kernel_size; x += 1.0f) {
            for (var y = -pcf_half_kernel_size; y <= pcf_half_kernel_size; y += 1.0f) {

                let offset_uv = vec2(x, y) / f32(textureDimensions(directional_shadow_maps).x) * spread;

                let sample_uv = shadow_position.xy + offset_uv;
                pcf_shadow_factor += textureSampleCompare(directional_shadow_maps,
                    shadow_sampler,
                    sample_uv, l, shadow_depth);
                pcf_sample_count += 1u;
            }
        }

        pcf_shadow_factor /= f32(pcf_sample_count);
        factor *= pcf_shadow_factor;

#endif
    }

    return factor;
}

fn sun_shadow_factor(frag_position: vec3<f32>, cam_pos: vec3<f32>) -> f32 {

    var factor: f32 = max(f32(uLights.sun_count), 1.0f) * 1.0f; // show by default
    var bias: f32 = 0.001f;

    for (var l: u32 = 0u; l < uLights.sun_count; l++) {

        let layer = uLights.spot_count + l;
        let light = uLights.sun_entries[l];
        let shadow_position = directional_shadow_position(frag_position, light.view);

#ifdef RENDER_SHADOW_AS_COLOR
        factor *= textureSample(directional_shadow_maps, directional_shadow_sampler,
            shadow_position.xy, l)
                  .r;

#else

        let frag_to_light = light.position - frag_position;
        let light_direction = normalize(frag_to_light);
        let shadow_depth = shadow_position.z - bias;

    // PCF
        var pcf_shadow_factor = 0.0f;
        var pcf_sample_count = 0u;
        let pcf_kernel_size = PCF_KERNEL_MAX;
        let pcf_half_kernel_size: f32 = f32(pcf_kernel_size / 2u);
        let spread = 1.0f;

        for (var x = -pcf_half_kernel_size; x <= pcf_half_kernel_size; x += 1.0f) {
            for (var y = -pcf_half_kernel_size; y <= pcf_half_kernel_size; y += 1.0f) {

                let offset_uv = vec2(x, y) / f32(textureDimensions(directional_shadow_maps).x) * spread;

                let sample_uv = shadow_position.xy + offset_uv;
                pcf_shadow_factor += textureSampleCompare(
                    directional_shadow_maps, shadow_sampler, sample_uv,
                    layer, shadow_depth
                );
                pcf_sample_count += 1u;
            }
        }

        pcf_shadow_factor /= f32(pcf_sample_count);
        factor *= pcf_shadow_factor;

#endif
    }

    return factor;
}

//
//
//
//
