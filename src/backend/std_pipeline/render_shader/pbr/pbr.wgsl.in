
// attribute/uniform decls
// WGSL Function references:
// https://webgpufundamentals.org/webgpu/lessons/webgpu-wgsl-function-reference.html#func-textureSampleCompareLevel

// constants
const PI : f32 = 3.14159265359;
const POINT_LIGHT_VIEWS : u32 = 6u;
const MAX_LIGHT : u32 = 16u;

struct VertexIn {
  @location(0) aPos: vec3<f32>,
  @location(1) aNorm: vec3<f32>,
  @location(2) aTan: vec4<f32>,
  @location(3) aCol: vec3<f32>,
  @location(4) aUv: vec2<f32>,
};

struct VertexOut {
  @builtin(position) vPosition: vec4<f32>,
  @location(0) vNormal: vec3<f32>,
  @location(1) vTangent: vec3<f32>,
  @location(2) vBitangent: vec3<f32>,
  @location(3) vCol: vec3<f32>,
  @location(4) vUv: vec2<f32>,
  @location(5) vFrag: vec3<f32>,
};

struct Mesh {
  model: mat4x4<f32>,
  position: vec4<f32>,
  probe_reflection_plane_count: u32,
  probe_reflection_grid_count: u32,
}

struct Camera {
  view: mat4x4<f32>,
  position: vec4<f32>,
  lookat: vec4<f32>,
  mode: u32,
};

struct Viewport {
  projection: mat4x4<f32>,
  width: u32,
  height: u32
};

struct Material {
  albedo: vec4<f32>,
  metallic: f32,
  roughness: f32,
  normal: vec3<f32>,
  occlusion: f32,
  emissive: vec3<f32>,
  alpha: f32,
};


struct PBRMaterial {
  base_color_factor: vec4<f32>,
  emissive_factor: vec3<f32>,
  metallic_factor: f32,
  roughness_factor: f32,
  specular_factor: f32,
  normal_scale: f32,
  occlusion_strength: f32,
  alpha_threshold: f32,
}

// === Environment ===

  // Lights
struct PointLight {
  position: vec3<f32>,
  cutoff: f32,
  color: vec4<f32>,
  views: array<mat4x4<f32>, 6>,
  intensity: f32,
  inner_cutoff: f32,
  near: f32,
  far: f32,
};

struct AmbientLight {
  color: vec4<f32>,
  intensity: f32,
};

struct SpotLight {
  position: vec3<f32>,
  cutoff: f32,
  lookat: vec3<f32>,
  inner_cutoff: f32,
  color: vec4<f32>,
  view: mat4x4<f32>,
  intensity: f32,
};

struct SunLight {
  position: vec3<f32>,
  intensity: f32,
  color: vec4<f32>,
  view: mat4x4<f32>,
};


// === Plane Reflection ===
struct Projection {
  view: mat4x4<f32>,
};

struct PlaneReflection {
  position: vec3<f32>,
  near: f32,
  normal: vec3<f32>,
  far: f32,
  scale: vec3<f32>,
  distance: f32,
  tangent: vec3<f32>,
  signed_distance: f32,
  bitangent: vec3<f32>,
  texture_layer: u32,
  view: mat4x4<f32>,
}

struct ProbeReflection {
  position: vec3<f32>,
  radius: f32,
}

  
const LIGHT_ARRAY_CAPACITY : u32 = 16u;
struct LightList {
  ambient_entries: array<AmbientLight, LIGHT_ARRAY_CAPACITY>,
  point_entries: array<PointLight, LIGHT_ARRAY_CAPACITY>,
  spot_entries: array<SpotLight, LIGHT_ARRAY_CAPACITY>,
  sun_entries: array<SunLight, LIGHT_ARRAY_CAPACITY>,
  ambient_count: u32,
  point_count: u32,
  spot_count: u32,
  sun_count: u32,
};

const PROBE_ARRAY_CAPACITY : u32 = 16u;
struct ProbeList {
  reflection_plane: array<PlaneReflection, PROBE_ARRAY_CAPACITY>,
  reflection_probe: array<PlaneReflection, PROBE_ARRAY_CAPACITY>,
  probe_count: u32,
  plane_count: u32,
  irradiance_count: u32,
}

struct Fog {
  color: vec4<f32>,
  start_distance: f32,
  density: f32,
}

struct Environment {
  fog: Fog,
}



// material pbr
// 1. texture : The actual image data stored in VRAM (pixel colors, normal maps,
// etc.)
// 2. sampler : Defines how the GPU reads the texture (filtering, wrapping,
// mipmaps, etc.)
// TODO: combine textures in a texture_2d_array + only use 1 sampler ?

// camera viewport
@group(0) @binding(0) var<uniform> uViewport : Viewport;
@group(0) @binding(1) var<uniform> uCamera : Camera;
@group(0) @binding(2) var<uniform> uMesh : Mesh;

// TODO replace with array
@group(1) @binding(0) var diffuse_texture : texture_2d<f32>;
@group(1) @binding(1) var metallic_texture : texture_2d<f32>;
@group(1) @binding(2) var normal_texture : texture_2d<f32>;
@group(1) @binding(3) var emissive_texture : texture_2d<f32>;
@group(1) @binding(4) var occlusion_texture : texture_2d<f32>;
@group(1) @binding(5) var linear_sampler : sampler;
@group(1) @binding(6) var<uniform> uPBR : PBRMaterial;

// light
@group(2) @binding(0) var<uniform> uEnvironment : Environment;
@group(2) @binding(1) var<uniform> uLights : LightList;
@group(2) @binding(2) var<uniform> uProbes : ProbeList;
  
#ifdef RENDER_SHADOW_AS_COLOR
@group(2) @binding(3) var point_shadow_maps : texture_cube_array<f32>;
@group(2) @binding(4) var directional_shadow_maps : texture_2d_array<f32>;
#else
@group(2) @binding(3) var point_shadow_maps : texture_depth_cube_array;
@group(2) @binding(4) var directional_shadow_maps : texture_depth_2d_array;
@group(2) @binding(5) var shadow_sampler : sampler_comparison;
#endif

@group(2) @binding(6) var probe_reflection_plane_texture: texture_2d_array<f32>;
@group(2) @binding(7) var probe_reflection_grid_texture: texture_cube_array<f32>;
@group(2) @binding(8) var skybox_texture : texture_cube<f32>;

